# Auth.js (NextAuth v5) — Google Sign-In only.
# Generate AUTH_SECRET with: openssl rand -base64 32
# If AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET are missing, the app still boots in demo-local mode.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# optional: AUTH_URL=http://localhost:3000

# MongoDB (database name is always "datedrop")
MONGODB_URI=

# Vercel Blob for private screenshots. If missing, files are stored locally with a warning.
BLOB_READ_WRITE_TOKEN=

# Places — free stack (no Google billing required)
# PLACES_PROVIDER=geoapify|locationiq|nominatim  (default: geoapify if key set, else locationiq, else nominatim)
PLACES_PROVIDER=
GEOAPIFY_API_KEY=
LOCATIONIQ_API_KEY=
# Nominatim needs no key (server proxy, 1 req/s, cached 24h)

# Optional legacy Google Places / Maps (app works fully without these)
GOOGLE_PLACES_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Vision LLM — Gemini primary, Groq fallback
# LLM_PROVIDER=gemini|groq|auto  (default auto = gemini then groq)
LLM_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
# optional override: GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Optional
OPENAI_API_KEY=

# Test mocks
# MOCK_AI=1
# MOCK_PLACES=1
